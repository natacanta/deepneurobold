# DeepNeuroBOLD environment configuration
# Copy to .env and fill in with your local paths. .env is git-ignored.

# Required
DNB_DATA_ROOT=/path/to/patient/data
DNB_OUTPUT_ROOT=/path/to/pipeline/output

# Optional
DNB_FOLLOWUP_ROOT=/path/to/registered/followups
DNB_ENV_PYTHON=/path/to/venv/bin/python
DNB_SURGERY_DATES_CSV=/path/to/surgery_dates.csv
